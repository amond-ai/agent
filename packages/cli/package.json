{
  "name": "@flue/cli",
  "type": "module",
  "version": "2.3.0",
  "license": "Apache-2.0",
  "homepage": "https://flueframework.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/withastro/flue",
    "directory": "packages/cli"
  },
  "bin": {
    "flue": "bin/flue.mjs"
  },
  "files": [
    "bin/flue.mjs",
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prebuild": "bun scripts/generate-blueprint-index.ts",
    "build": "tsdown && mv dist/flue.mjs dist/flue.js",
    "check:types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --bun vitest run --passWithNoTests"
  },
  "dependencies": {
    "@flue/runtime": "workspace:*",
    "@flue/vite": "workspace:*",
    "@vercel/detect-agent": "^1.2.3",
    "cac": "^7.0.0",
    "minisearch": "^7.2.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "ulidx": "^2.4.1",
    "vite": "^8.1.2"
  },
  "devDependencies": {
    "@flue/sdk": "workspace:*",
    "@types/node": "catalog:",
    "@types/prompts": "^2.4.9",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
