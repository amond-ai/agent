{
  "name": "amond",
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "homepage": "https://flueframework.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/withastro/flue",
    "directory": "packages/cli"
  },
  "bin": {
    "amond": "bin/amond.mjs"
  },
  "files": [
    "bin/amond.mjs",
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prebuild": "bun scripts/generate-blueprint-index.ts",
    "build": "tsdown && mv dist/amond.mjs dist/amond.js",
    "check": "bun scripts/generate-blueprint-index.ts && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --bun vitest run --passWithNoTests"
  },
  "dependencies": {
    "@amond-ai/agent": "workspace:*",
    "@amond-ai/agent-vite": "workspace:*",
    "@vercel/detect-agent": "^1.2.3",
    "cac": "^7.0.0",
    "minisearch": "^7.2.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "ulidx": "^2.4.1",
    "vite": "^8.1.2"
  },
  "devDependencies": {
    "@amond-ai/agent-sdk": "workspace:*",
    "@types/node": "catalog:",
    "@types/prompts": "^2.4.9",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
