{
  "name": "@amond-ai/agent-core",
  "type": "module",
  "version": "0.2.0",
  "description": "The agent contract: the filesystem layout, the loader that resolves it, and the handlers a platform invokes",
  "author": "Passion Factory Corp.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/amond-ai/agent/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amond-ai/agent.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/amond-ai/agent/issues"
  },
  "keywords": [
    "agent",
    "framework",
    "claude-code",
    "filesystem",
    "loader"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "NOTICE",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --bun vitest run --passWithNoTests"
  },
  "dependencies": {
    "@amond-ai/agent-durable": "workspace:*"
  },
  "devDependencies": {
    "@pleaseai/eslint-config": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
