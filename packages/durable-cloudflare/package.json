{
  "name": "@amond-ai/agent-durable-cloudflare",
  "type": "module",
  "version": "0.1.0",
  "description": "Cloudflare Workflows behind the durable contract",
  "author": "Passion Factory Corp.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/amond-ai/agent/tree/main/packages/durable-cloudflare#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amond-ai/agent.git",
    "directory": "packages/durable-cloudflare"
  },
  "bugs": {
    "url": "https://github.com/amond-ai/agent/issues"
  },
  "keywords": ["agent", "durable", "cloudflare", "workflows", "workers"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "NOTICE",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --bun vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "catalog:workers-v5"
  },
  "dependencies": {
    "@amond-ai/agent-durable": "workspace:*"
  },
  "devDependencies": {
    "@pleaseai/eslint-config": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
